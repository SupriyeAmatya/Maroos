@* =====================================================================================================
   FILE: Maroos.Web/Components/Pages/Search.razor      URL: /search?q=...&page=N
   PURPOSE: Card search. Accepts a card name or full Scryfall search syntax ("t:dragon c:r cmc<=4") and shows
   a grid of card images, 175 per page, with Previous/Next.
   BEHAVIOUR
     * The query lives in the URL (?q=), so searches can be bookmarked and Back works.
     * Picking an autocomplete suggestion searches for that exact name (!"Name"), which usually has one
       result — and a single result jumps straight to the card page, like Scryfall does.
   RENDERING: InteractiveServer (the autocomplete needs live keystroke handling).
   ===================================================================================================== *@
@page "/search"
@rendermode InteractiveServer

@inject CardService Cards
@inject NavigationManager Navigation

@* Tab title: "lightning bolt – Search · Maroos", or just "Search · Maroos". *@
<PageTitle>@(string.IsNullOrWhiteSpace(Q) ? "Search" : $"{Q} – Search") · Maroos</PageTitle>

<h1>Card search</h1>

<div class="card-search mb-3" role="search">
    @* The shared autocomplete box; OnSearch runs when the user submits. *@
    <CardAutocomplete Text="@Q" OnSubmit="OnSearch" InputClass="form-control-lg" ButtonText="Search"
                      AriaLabel="Card name or Scryfall query"
                      Placeholder="Card name or Scryfall query, e.g. lightning bolt or t:dragon c:r" />
    <div class="form-text">
        Supports <a href="https://scryfall.com/docs/syntax" target="_blank" rel="noopener">Scryfall search syntax</a>.
    </div>
</div>

@* Four states: error, loading, results (maybe none), or nothing searched yet. *@
@if (error is not null)
{
    <div class="alert alert-warning">@error</div>
}
else if (loading)
{
    <p class="text-muted">Searching…</p>
}
else if (results is not null)
{
    @if (results.TotalCards == 0)
    {
        <p>No cards found for <strong>@Q</strong>.</p>
    }
    else
    {
        @* Result count with thousands separator ("1,234 cards"). *@
        <p class="text-muted">@results.TotalCards.ToString("N0") card@(results.TotalCards == 1 ? "" : "s")</p>

        @* The grid: each image links to the card page. loading="lazy" loads images as they scroll into view. *@
        <div class="card-grid">
            @foreach (var card in results.Data)
            {
                <a class="card-grid-item" href="card/@card.Id" title="@card.Name">
                    @if (card.FrontImage?.Normal is { } image)
                    {
                        <img src="@image" alt="@card.Name" loading="lazy" />
                    }
                    else
                    {
                        <span class="card-grid-placeholder">@card.Name</span>
                    }
                </a>
            }
        </div>

        @* Paging links (only when there's more than one page). *@
        @if (PageNumber > 1 || results.HasMore)
        {
            <nav class="d-flex gap-2 justify-content-center my-4" aria-label="Search pages">
                @if (PageNumber > 1)
                {
                    <a class="btn btn-outline-secondary" href="@PageUrl(PageNumber - 1)">Previous</a>
                }
                <span class="align-self-center">Page @PageNumber</span>
                @if (results.HasMore)
                {
                    <a class="btn btn-outline-secondary" href="@PageUrl(PageNumber + 1)">Next</a>
                }
            </nav>
        }
    }
}

@code {
    // Values read from the URL's query string: ?q=...&page=...
    [SupplyParameterFromQuery] public string? Q { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int? PageParam { get; set; }

    // PageNumber: the page, never below 1 (a bad ?page= value can't break the search).
    private int PageNumber => Math.Max(1, PageParam ?? 1);

    // results: the current page of cards (null = nothing searched). loading / error: UI state.
    private ScryfallList<ScryfallCard>? results;
    private bool loading;
    private string? error;

    // OnParametersSetAsync: runs whenever the URL's q/page change — run the search.
    protected override async Task OnParametersSetAsync()
    {
        error = null;
        results = null;
        if (string.IsNullOrWhiteSpace(Q))
            return;

        loading = true;
        try
        {
            results = await Cards.SearchAsync(Q, PageNumber);
        }
        // Scryfall rejects bad syntax (or is unreachable): show a friendly message.
        catch (HttpRequestException)
        {
            error = "Scryfall couldn't run that search. Check the query syntax or try again in a moment.";
        }
        finally
        {
            loading = false;
        }

        // Like Scryfall: a search with a single match goes straight to the card. Replace the history
        // entry so Back doesn't bounce the user into the same redirect.
        // (`Data: [var only]` is a list pattern: "exactly one item, call it only".)
        if (results is { TotalCards: 1, Data: [var only] })
            Navigation.NavigateTo($"card/{only.Id}", replace: true);
    }

    /// <summary>A picked suggestion searches for that exact name, which lands on the card page.</summary>
    // OnSearch: put the query in the URL; OnParametersSetAsync then runs the search.
    // (!"Name" is Scryfall's exact-name syntax.)
    private void OnSearch(CardAutocompleteSubmit submit)
    {
        var query = submit.IsSuggestion ? $"!\"{submit.Text}\"" : submit.Text;
        var url = $"search?q={Uri.EscapeDataString(query)}";
        if (Navigation.ToBaseRelativePath(Navigation.Uri) != url)
            Navigation.NavigateTo(url);
    }

    // PageUrl: the current URL with a different page number.
    private string PageUrl(int page) =>
        Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { ["q"] = Q, ["page"] = page });
}
