@page "/search"
@rendermode InteractiveServer
@implements IDisposable

@inject CardService Cards
@inject NavigationManager Navigation

<PageTitle>@(string.IsNullOrWhiteSpace(Q) ? "Search" : $"{Q} – Search") · Maroos</PageTitle>

<h1>Card search</h1>

@* Not a <form>: Enter is handled in OnKeyDown so it can either search or open the highlighted suggestion. *@
<div class="card-search mb-3" role="search">
    <div class="card-search-box">
        <div class="input-group">
            <input class="form-control form-control-lg" type="search" autocomplete="off"
                   role="combobox" aria-autocomplete="list" aria-controls="card-suggestions"
                   aria-expanded="@(ShowSuggestions ? "true" : "false")"
                   aria-activedescendant="@(highlighted >= 0 ? $"card-suggestion-{highlighted}" : null)"
                   aria-label="Card name or Scryfall query" placeholder="Card name or Scryfall query, e.g. lightning bolt or t:dragon c:r"
                   @bind="text" @bind:event="oninput" @bind:after="OnTextChanged"
                   @onkeydown="OnKeyDown" @onblur="HideSuggestions" />
            <button class="btn btn-primary" type="button" @onclick="Submit">Search</button>
        </div>
        @if (ShowSuggestions)
        {
            <ul id="card-suggestions" class="card-suggestions list-group shadow" role="listbox" aria-label="Card name suggestions">
                @for (var i = 0; i < suggestions.Count; i++)
                {
                    var index = i;
                    <li id="card-suggestion-@index" role="option" aria-selected="@(index == highlighted ? "true" : "false")"
                        class="list-group-item list-group-item-action @(index == highlighted ? "active" : "")"
                        @onmousedown="() => Choose(suggestions[index])" @onmousedown:preventDefault>
                        @suggestions[index]
                    </li>
                }
            </ul>
        }
    </div>
    <div class="form-text">
        Supports <a href="https://scryfall.com/docs/syntax" target="_blank" rel="noopener">Scryfall search syntax</a>.
    </div>
</div>

@if (error is not null)
{
    <div class="alert alert-warning">@error</div>
}
else if (loading)
{
    <p class="text-muted">Searching…</p>
}
else if (results is not null)
{
    @if (results.TotalCards == 0)
    {
        <p>No cards found for <strong>@Q</strong>.</p>
    }
    else
    {
        <p class="text-muted">@results.TotalCards.ToString("N0") card@(results.TotalCards == 1 ? "" : "s")</p>

        <div class="card-grid">
            @foreach (var card in results.Data)
            {
                <a class="card-grid-item" href="card/@card.Id" title="@card.Name">
                    @if (card.FrontImage?.Normal is { } image)
                    {
                        <img src="@image" alt="@card.Name" loading="lazy" />
                    }
                    else
                    {
                        <span class="card-grid-placeholder">@card.Name</span>
                    }
                </a>
            }
        </div>

        @if (PageNumber > 1 || results.HasMore)
        {
            <nav class="d-flex gap-2 justify-content-center my-4" aria-label="Search pages">
                @if (PageNumber > 1)
                {
                    <a class="btn btn-outline-secondary" href="@PageUrl(PageNumber - 1)">Previous</a>
                }
                <span class="align-self-center">Page @PageNumber</span>
                @if (results.HasMore)
                {
                    <a class="btn btn-outline-secondary" href="@PageUrl(PageNumber + 1)">Next</a>
                }
            </nav>
        }
    }
}

@code {
    private static readonly TimeSpan AutocompleteDelay = TimeSpan.FromMilliseconds(300);

    [SupplyParameterFromQuery] public string? Q { get; set; }
    [SupplyParameterFromQuery(Name = "page")] public int? PageParam { get; set; }

    private int PageNumber => Math.Max(1, PageParam ?? 1);

    private string text = "";
    private IReadOnlyList<string> suggestions = [];
    private int highlighted = -1;
    private bool suggestionsOpen;
    private ScryfallList<ScryfallCard>? results;
    private bool loading;
    private string? error;
    private CancellationTokenSource? typing;

    private bool ShowSuggestions => suggestionsOpen && suggestions.Count > 0;

    protected override async Task OnParametersSetAsync()
    {
        text = Q ?? "";
        CloseSuggestions();
        error = null;
        results = null;
        if (string.IsNullOrWhiteSpace(Q))
            return;

        loading = true;
        try
        {
            results = await Cards.SearchAsync(Q, PageNumber);
        }
        catch (HttpRequestException)
        {
            error = "Scryfall couldn't run that search. Check the query syntax or try again in a moment.";
        }
        finally
        {
            loading = false;
        }

        // Like Scryfall: a search with a single match goes straight to the card. Replace the history
        // entry so Back doesn't bounce the user into the same redirect.
        if (results is { TotalCards: 1, Data: [var only] })
            Navigation.NavigateTo($"card/{only.Id}", replace: true);
    }

    private async Task OnTextChanged()
    {
        var token = RestartTyping();
        try
        {
            await Task.Delay(AutocompleteDelay, token);
            suggestions = await Cards.AutocompleteAsync(text, token);
            highlighted = -1;
            suggestionsOpen = true;
        }
        catch (OperationCanceledException)
        {
            // A newer keystroke (or a search) replaced this one.
        }
        catch (HttpRequestException)
        {
            suggestions = [];
        }
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowDown" when ShowSuggestions:
                highlighted = (highlighted + 1) % suggestions.Count;
                break;
            case "ArrowUp" when ShowSuggestions:
                highlighted = highlighted <= 0 ? suggestions.Count - 1 : highlighted - 1;
                break;
            case "Escape":
                CloseSuggestions();
                break;
            case "Enter" when ShowSuggestions && highlighted >= 0:
                Choose(suggestions[highlighted]);
                break;
            case "Enter":
                Submit();
                break;
        }
    }

    private void HideSuggestions() => suggestionsOpen = false;

    /// <summary>Picking a suggestion searches for that exact name, which lands on the card page.</summary>
    private void Choose(string name)
    {
        text = name;
        NavigateToSearch($"!\"{name}\"");
    }

    private void Submit() => NavigateToSearch(text);

    private void NavigateToSearch(string query)
    {
        if (string.IsNullOrWhiteSpace(query))
            return;

        RestartTyping();
        CloseSuggestions();
        var url = $"search?q={Uri.EscapeDataString(query.Trim())}";
        if (Navigation.ToBaseRelativePath(Navigation.Uri) != url)
            Navigation.NavigateTo(url);
    }

    private void CloseSuggestions()
    {
        suggestions = [];
        suggestionsOpen = false;
        highlighted = -1;
    }

    /// <summary>Cancels any pending autocomplete and returns a token for the next one.</summary>
    private CancellationToken RestartTyping()
    {
        typing?.Cancel();
        typing?.Dispose();
        typing = new CancellationTokenSource();
        return typing.Token;
    }

    private string PageUrl(int page) =>
        Navigation.GetUriWithQueryParameters(new Dictionary<string, object?> { ["q"] = Q, ["page"] = page });

    public void Dispose()
    {
        typing?.Cancel();
        typing?.Dispose();
    }
}
