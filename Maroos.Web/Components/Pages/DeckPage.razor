@* =====================================================================================================
   FILE: Maroos.Web/Components/Pages/DeckPage.razor      URL: /decks/{id}
   PURPOSE: The deck builder (Moxfield-style). One page for both viewing and editing:
     * Header: name, format, public/private, legality badge ("✓ Legal" or "⚠ 3 issues"), card counts, price.
     * Toolbar: Import (owner) · Export (anyone) · Settings (owner: rename, format, visibility, delete).
     * Add card (owner): the shared autocomplete + a Main/Sideboard/Commander picker.
     * Legality issues list (from DeckRules).
     * Card list grouped Commander → Creatures, Instants, ... → Sideboard, with mana costs, +/− buttons
       (owner), and a card image preview that follows the mouse.
     * DeckStatsPanel: curve, colors, types, price.
   WHO SEES WHAT: anyone can view a PUBLIC deck (and watch it); only the owner sees edit controls; a private
   deck of someone else shows "Deck not found". DeckService enforces the same rules on every change.
   RENDERING: InteractiveServer.
   ===================================================================================================== *@
@page "/decks/{Id:guid}"
@rendermode InteractiveServer

@inject DeckService DeckService
@* IJSRuntime: calls browser JavaScript (used only for "copy to clipboard"). *@
@inject IJSRuntime JS
@inject NavigationManager Navigation

@* ---- Not loaded yet, missing, or private ---- *@
@if (view is null)
{
    <PageTitle>@(loading ? "Deck" : "Deck not found") · Maroos</PageTitle>
    @if (loading)
    {
        <p class="text-muted">Loading deck…</p>
    }
    else
    {
        <h1>Deck not found</h1>
        <p>This deck doesn't exist, or it's private. <a href="decks">Back to my decks</a>.</p>
    }
}
else
{
    var deck = view.Deck;
    <PageTitle>@deck.Name · Maroos</PageTitle>

    @* ---- Header ---- *@
    <header class="deck-header mb-3">
        <div class="d-flex flex-wrap align-items-center gap-2">
            <h1 class="mb-0 me-2">@deck.Name</h1>
            <span class="badge text-bg-primary">@DeckFormats.DisplayName(deck.Format)</span>
            <span class="badge @(deck.IsPublic ? "text-bg-success" : "text-bg-secondary")">@(deck.IsPublic ? "Public" : "Private")</span>
            @* You can watch other people's decks, not your own. *@
            @if (!view.IsOwner)
            {
                <WatchButton Target="WatchTarget.Deck" TargetId="deck.Id" />
            }
            @* Legality badge (only once the deck has cards); the issue badge links down to the issues list. *@
            @if (view.Entries.Count > 0)
            {
                @if (view.Issues.Count == 0)
                {
                    <span class="badge text-bg-success deck-legal-badge">✓ Legal in @DeckFormats.DisplayName(deck.Format)</span>
                }
                else
                {
                    <a class="badge text-bg-danger deck-legal-badge text-decoration-none" href="@($"decks/{deck.Id}#deck-issues")">
                        ⚠ @view.Issues.Count issue@(view.Issues.Count == 1 ? "" : "s")
                    </a>
                }
            }
        </div>
        @* Counts line: "Commander 1 · Main 99 · Sideboard 10 · $412.50". *@
        <p class="text-muted mb-0 mt-1">
            @if (view.Count(Board.Commander) > 0)
            {
                <span>Commander @view.Count(Board.Commander) · </span>
            }
            Main @view.Count(Board.Main)
            @if (view.Count(Board.Side) > 0)
            {
                <span> · Sideboard @view.Count(Board.Side)</span>
            }
            @if (view.Entries.Count > 0)
            {
                <span> · @Money.FormatUsd(view.Stats.TotalPriceCents)</span>
            }
        </p>
    </header>

    @* ---- Toolbar: each button opens/closes one panel (aria-expanded tells screen readers which is open). ---- *@
    <div class="deck-toolbar d-flex flex-wrap gap-2 mb-3">
        @if (view.IsOwner)
        {
            <button type="button" class="btn btn-outline-secondary @(panel == Panel.Import ? "active" : "")" aria-expanded="@(panel == Panel.Import)" @onclick="() => Toggle(Panel.Import)">Import</button>
        }
        <button type="button" class="btn btn-outline-secondary @(panel == Panel.Export ? "active" : "")" aria-expanded="@(panel == Panel.Export)" @onclick="() => Toggle(Panel.Export)">Export</button>
        @if (view.IsOwner)
        {
            <button type="button" class="btn btn-outline-secondary @(panel == Panel.Settings ? "active" : "")" aria-expanded="@(panel == Panel.Settings)" @onclick="() => Toggle(Panel.Settings)">Settings</button>
        }
    </div>

    @* ---- Import panel (owner): paste a list, choose Add or Replace ---- *@
    @if (panel == Panel.Import && view.IsOwner)
    {
        <section class="deck-panel card card-body mb-3" aria-label="Import a deck list">
            <label for="import-text" class="form-label">Paste a deck list — one card per line, like <code>4 Lightning Bolt</code> or <code>1 Sol Ring (C21) 263</code>. A <code>Sideboard</code> line starts the sideboard.</label>
            <textarea id="import-text" class="form-control font-monospace mb-2" rows="12" @bind="importText" disabled="@busy"></textarea>
            <div class="d-flex flex-wrap align-items-center gap-3">
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="import-mode" id="import-add" checked="@(!importReplaces)" @onchange="() => importReplaces = false" />
                    <label class="form-check-label" for="import-add">Add to deck</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="import-mode" id="import-replace" checked="@importReplaces" @onchange="() => importReplaces = true" />
                    <label class="form-check-label" for="import-replace">Replace deck</label>
                </div>
                <button type="button" class="btn btn-primary ms-auto" disabled="@(busy || string.IsNullOrWhiteSpace(importText))" @onclick="ImportAsync">
                    @(busy ? "Importing…" : "Import")
                </button>
            </div>
        </section>
    }

    @* ---- Export panel (anyone): the deck as text, optionally with set codes, and a Copy button ---- *@
    @if (panel == Panel.Export)
    {
        <section class="deck-panel card card-body mb-3" aria-label="Export the deck list">
            <label for="export-text" class="form-label">Deck list — paste it into Moxfield, Arena, MTGO or back into Maroos.</label>
            <textarea id="export-text" class="form-control font-monospace mb-2" rows="12" readonly value="@view.Export(exportPrintings)"></textarea>
            <div class="d-flex flex-wrap align-items-center gap-3">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="export-printings" @bind="exportPrintings" />
                    <label class="form-check-label" for="export-printings">Include set codes</label>
                </div>
                <button type="button" class="btn btn-primary ms-auto" @onclick="CopyExportAsync">Copy</button>
            </div>
        </section>
    }

    @* ---- Settings panel (owner): name, format, public; delete with a confirm step ---- *@
    @if (panel == Panel.Settings && view.IsOwner)
    {
        <section class="deck-panel card card-body mb-3" aria-label="Deck settings">
            <div class="row g-3">
                <div class="col-md-6">
                    <label for="settings-name" class="form-label">Name</label>
                    <input id="settings-name" class="form-control" maxlength="@Deck.MaxNameLength" @bind="settingsName" />
                </div>
                <div class="col-md-4">
                    <label for="settings-format" class="form-label">Format</label>
                    <select id="settings-format" class="form-select" @bind="settingsFormat">
                        @foreach (var format in DeckFormats.All)
                        {
                            <option value="@format">@DeckFormats.DisplayName(format)</option>
                        }
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="settings-public" @bind="settingsPublic" />
                        <label class="form-check-label" for="settings-public">Public</label>
                    </div>
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2 mt-3">
                <button type="button" class="btn btn-primary" disabled="@busy" @onclick="SaveSettingsAsync">Save</button>
                @if (confirmingDelete)
                {
                    <span class="ms-auto align-self-center">Delete this deck for good?</span>
                    <button type="button" class="btn btn-danger" disabled="@busy" @onclick="DeleteAsync">Delete</button>
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => confirmingDelete = false">Keep it</button>
                }
                else
                {
                    <button type="button" class="btn btn-outline-danger ms-auto" @onclick="() => confirmingDelete = true">Delete deck</button>
                }
            </div>
        </section>
    }

    @* ---- Add card (owner). @ref keeps a reference so we can clear the box after adding.
         The <select> inside becomes the component's ChildContent (shown between box and button). ---- *@
    @if (view.IsOwner)
    {
        <div class="deck-add mb-2">
            <CardAutocomplete @ref="addBox" ButtonText="Add" ListId="add-card-suggestions" Disabled="busy"
                              AriaLabel="Card to add" Placeholder="Add a card by name" OnSubmit="AddCardAsync">
                <select class="form-select deck-add-board" aria-label="Add to" @bind="addBoard">
                    <option value="@Board.Main">Main</option>
                    <option value="@Board.Side">Sideboard</option>
                    <option value="@Board.Commander">Commander</option>
                </select>
            </CardAutocomplete>
        </div>
    }

    @* ---- Legality issues (from DeckRules.Check), e.g. "Deck has 57 cards; Modern needs at least 60." ---- *@
    @if (view.Issues.Count > 0 && view.Entries.Count > 0)
    {
        <section id="deck-issues" class="alert alert-danger deck-issues" aria-labelledby="deck-issues-heading">
            <h2 id="deck-issues-heading" class="h6 alert-heading mb-2">
                ⚠ Not legal in @DeckFormats.DisplayName(deck.Format) yet
            </h2>
            <ul class="mb-0">
                @foreach (var issue in view.Issues)
                {
                    <li data-issue="@issue.Kind">@issue.Message</li>
                }
            </ul>
        </section>
    }

    @* ---- Status message after an action (plus import problems: not found / unreadable lines) ---- *@
    <div class="deck-status mb-3" role="status" aria-live="polite">
        @if (status is not null)
        {
            <div class="alert @(statusIsError ? "alert-warning" : "alert-success") py-2 mb-0">
                @status
                @if (importResult is { } result && (result.NotFound.Count > 0 || result.Unreadable.Count > 0))
                {
                    @if (result.NotFound.Count > 0)
                    {
                        <div class="mt-1"><strong>Not found on Scryfall:</strong> @string.Join(", ", result.NotFound)</div>
                    }
                    @if (result.Unreadable.Count > 0)
                    {
                        <div class="mt-1"><strong>Couldn't read:</strong> @string.Join(", ", result.Unreadable)</div>
                    }
                }
            </div>
        }
    </div>

    @* ---- The card list ---- *@
    @if (view.Entries.Count == 0)
    {
        <p class="text-muted">No cards yet. @(view.IsOwner ? "Add cards above or import a list." : "")</p>
    }
    else
    {
        <div class="deck-layout">
            <div class="deck-columns">
                @* Commander first, then main-deck cards grouped by type in a fixed order, then sideboard. *@
                @if (view.Count(Board.Commander) > 0)
                {
                    @Group("Commander", Board.Commander, EntriesOn(Board.Commander))
                }
                @foreach (var type in CardTypes.DisplayOrder)
                {
                    var entries = EntriesOn(Board.Main).Where(e => e.PrimaryType == type).ToList();
                    if (entries.Count > 0)
                    {
                        @Group(CardTypes.GroupHeading(type), Board.Main, entries)
                    }
                }
                @if (view.Count(Board.Side) > 0)
                {
                    @Group("Sideboard", Board.Side, EntriesOn(Board.Side))
                }
            </div>
            @* Preview image: the hovered card, or the first card. Decorative, so hidden from screen readers. *@
            <aside class="deck-preview" aria-hidden="true">
                @if ((preview ?? view.Entries.FirstOrDefault())?.Card?.FrontImage?.Normal is { } image)
                {
                    <img src="@image" alt="" />
                }
            </aside>
        </div>

        <DeckStatsPanel Stats="view.Stats" />
    }
}

@code {
    // Panel: which toolbar panel is open.
    private enum Panel { None, Import, Export, Settings }

    // Id: from the URL.
    [Parameter] public Guid Id { get; set; }

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    // view: the deck for this viewer (null = loading or not found). userId: null when signed out.
    private DeckView? view;
    private string? userId;
    private bool loading = true;
    // busy: an action is running (buttons disabled). panel: the open panel. preview: the hovered card.
    private bool busy;
    private Panel panel;
    private DeckEntry? preview;

    // Status message after an action, and the last import's result (for its problem lists).
    private string? status;
    private bool statusIsError;
    private DeckImportResult? importResult;

    // Add-card box and the board new cards go to.
    private CardAutocomplete? addBox;
    private Board addBoard = Board.Main;

    // Import and export panel state.
    private string importText = "";
    private bool importReplaces;
    private bool exportPrintings;

    // Settings panel state (copied from the deck when the panel opens).
    private string settingsName = "";
    private string settingsFormat = DeckFormats.Default;
    private bool settingsPublic;
    private bool confirmingDelete;

    // OnParametersSetAsync: first load (and when the id changes).
    protected override async Task OnParametersSetAsync()
    {
        userId = (await AuthState).User.GetUserId();
        await ReloadAsync();
        loading = false;
    }

    // ReloadAsync: fetch the deck again (after every change). Keeps the preview on the same card if it still exists.
    private async Task ReloadAsync()
    {
        view = await DeckService.GetAsync(Id, userId);
        if (preview is not null && view is not null)
            preview = view.Entries.FirstOrDefault(e => e.Line.ScryfallId == preview.Line.ScryfallId && e.Line.Board == preview.Line.Board);
    }

    // EntriesOn: the cards on one board.
    private IEnumerable<DeckEntry> EntriesOn(Board board) => view!.Entries.Where(e => e.Line.Board == board);

    /// <summary>The first card-level issue for this row's card, if any.</summary>
    private DeckIssue? IssueFor(DeckEntry entry) =>
        view!.Issues.FirstOrDefault(i => string.Equals(i.CardName, entry.Line.CardName, StringComparison.OrdinalIgnoreCase));

    // Group: a reusable piece of markup ("RenderFragment") — one card group with its heading and rows.
    // `__builder =>` is the Razor convention for writing markup inside a C# method.
    private RenderFragment Group(string heading, Board board, IEnumerable<DeckEntry> entries) => __builder =>
    {
        var list = entries.ToList();
        <section class="deck-group">
            @* Heading with the group's total, e.g. "Creatures (24)". *@
            <h2 class="h6 deck-group-heading">@heading <span class="text-muted">(@list.Sum(e => e.Line.Quantity))</span></h2>
            <ul class="list-unstyled deck-group-list">
                @foreach (var entry in list)
                {
                    @* issue: e.g. "Banned" or "Too many copies" for this card (row turns red with a badge).
                       @key helps Blazor keep rows stable when the list changes; hovering sets the preview. *@
                    var issue = IssueFor(entry);
                    <li class="deck-row @(issue is null ? "" : "deck-row-issue")" @key="(entry.Line.ScryfallId, entry.Line.Board)" @onmouseenter="() => preview = entry">
                        <span class="deck-row-qty">@entry.Line.Quantity</span>
                        <a class="deck-row-name" href="card/@entry.Line.ScryfallId">@entry.Line.CardName</a>
                        @if (issue is not null)
                        {
                            <span class="badge text-bg-danger deck-row-flag" title="@issue.Message">@issue.Label</span>
                        }
                        <span class="deck-row-cost"><ManaText Text="@entry.Card?.FrontManaCost" /></span>
                        @* − / + buttons for the owner (aria-label names the card for screen readers). *@
                        @if (view!.IsOwner)
                        {
                            <span class="deck-row-actions">
                                <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@busy"
                                        aria-label="Remove one @entry.Line.CardName"
                                        @onclick="() => AdjustAsync(entry, -1)">−</button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@busy"
                                        aria-label="Add one @entry.Line.CardName"
                                        @onclick="() => AdjustAsync(entry, 1)">+</button>
                            </span>
                        }
                    </li>
                }
            </ul>
        </section>
    };

    // Toggle: open a panel (or close it if already open). Opening Settings copies the current values in.
    private void Toggle(Panel target)
    {
        panel = panel == target ? Panel.None : target;
        confirmingDelete = false;
        if (panel == Panel.Settings && view is not null)
        {
            settingsName = view.Deck.Name;
            settingsFormat = view.Deck.Format;
            settingsPublic = view.Deck.IsPublic;
        }
    }

    // AddCardAsync: add one copy of the named card to the chosen board.
    private Task AddCardAsync(CardAutocompleteSubmit submit) => RunAsync(async () =>
    {
        var added = await DeckService.AddCardAsync(Id, userId!, submit.Text, addBoard);
        if (added is null)
        {
            Fail($"Scryfall has no card named “{submit.Text}”.");
            return;
        }
        addBox?.Clear();
        Succeed($"Added {added}{(addBoard == Board.Main ? "" : $" to the {BoardName(addBoard)}")}.");
    });

    // AdjustAsync: the − / + buttons.
    private Task AdjustAsync(DeckEntry entry, int delta) => RunAsync(async () =>
    {
        await DeckService.AdjustQuantityAsync(Id, userId!, entry.Line.ScryfallId, entry.Line.Board, delta);
        status = null;
    });

    // ImportAsync: import the pasted list. The panel closes only if everything was understood;
    // otherwise it stays open (with the text) so the user can fix the problem lines.
    private Task ImportAsync() => RunAsync(async () =>
    {
        var result = await DeckService.ImportAsync(Id, userId!, importText, importReplaces);
        var problems = result.NotFound.Count + result.Unreadable.Count;
        Succeed($"Imported {result.CardsAdded} card{(result.CardsAdded == 1 ? "" : "s")}.");
        statusIsError = problems > 0;
        importResult = result;
        if (problems == 0)
        {
            importText = "";
            panel = Panel.None;
        }
    });

    // SaveSettingsAsync: rename / format / visibility.
    private Task SaveSettingsAsync() => RunAsync(async () =>
    {
        await DeckService.UpdateSettingsAsync(Id, userId!, settingsName, settingsFormat, settingsPublic);
        panel = Panel.None;
        Succeed("Deck settings saved.");
    });

    // DeleteAsync: the confirmed Delete button; then back to "My decks".
    private async Task DeleteAsync()
    {
        busy = true;
        await DeckService.DeleteAsync(Id, userId!);
        Navigation.NavigateTo("decks");
    }

    // CopyExportAsync: copy the export text using the browser's clipboard API (may be blocked by the browser).
    private async Task CopyExportAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", view!.Export(exportPrintings));
            Succeed("Deck list copied.");
        }
        catch (JSException)
        {
            Fail("Couldn't copy automatically — select the list and copy it instead.");
        }
    }

    /// <summary>Runs a change, then reloads the deck; turns rule violations into a message instead of a crash.</summary>
    private async Task RunAsync(Func<Task> change)
    {
        busy = true;
        status = null;
        importResult = null;
        try
        {
            await change();
        }
        // Not the owner / bad name or format / deck deleted meanwhile.
        catch (Exception ex) when (ex is DeckAccessException or ArgumentException or KeyNotFoundException)
        {
            Fail(ex.Message);
        }
        catch (HttpRequestException)
        {
            Fail("Couldn't reach Scryfall. Try again in a moment.");
        }
        // Always reload, so the page shows the real state whatever happened.
        finally
        {
            await ReloadAsync();
            busy = false;
        }
    }

    // Helpers to set the status message (green for success, yellow for problems).
    private void Succeed(string message) => (status, statusIsError) = (message, false);

    private void Fail(string message) => (status, statusIsError) = (message, true);

    // BoardName: wording used in "Added X to the sideboard".
    private static string BoardName(Board board) => board switch
    {
        Board.Side => "sideboard",
        Board.Commander => "commander zone",
        _ => "main deck",
    };
}
