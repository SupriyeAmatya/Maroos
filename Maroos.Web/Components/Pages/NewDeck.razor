@* =====================================================================================================
   FILE: Maroos.Web/Components/Pages/NewDeck.razor      URL: /decks/new
   PURPOSE: The "New deck" form: name, format, public/private. On success it opens the new deck's page,
   where cards are added or a list is pasted in.
   HOW THE FORM WORKS: static server rendering with a real HTML form POST. [SupplyParameterFromForm] fills
   Input from the posted fields; the DataAnnotations attributes ([Required], ...) validate it; if valid,
   OnValidSubmit runs CreateAsync. The antiforgery token is added automatically by EditForm.
   SECURITY: [Authorize]; DeckService re-validates the name and format too.
   ===================================================================================================== *@
@page "/decks/new"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]

@inject DeckService DeckService
@inject NavigationManager Navigation

<PageTitle>New deck · Maroos</PageTitle>

<h1>New deck</h1>

@* FormName identifies this form when it posts back (needed for static-rendered forms). *@
<EditForm Model="Input" method="post" OnValidSubmit="CreateAsync" FormName="new-deck" class="new-deck-form">
    <DataAnnotationsValidator />
    <ValidationSummary class="text-danger" role="alert" />

    <div class="mb-3">
        <label for="deck-name" class="form-label">Name</label>
        <InputText id="deck-name" @bind-Value="Input.Name" class="form-control" placeholder="Mono-Red Burn" />
        <ValidationMessage For="() => Input.Name" class="text-danger" />
    </div>

    @* Format dropdown: every format in DeckFormats (Standard, Pioneer, Modern, Commander...). *@
    <div class="mb-3">
        <label for="deck-format" class="form-label">Format</label>
        <InputSelect id="deck-format" @bind-Value="Input.Format" class="form-select">
            @foreach (var format in DeckFormats.All)
            {
                <option value="@format">@DeckFormats.DisplayName(format)</option>
            }
        </InputSelect>
    </div>

    <div class="form-check mb-3">
        <InputCheckbox id="deck-public" @bind-Value="Input.IsPublic" class="form-check-input" />
        <label for="deck-public" class="form-check-label">Public — anyone with the link can view it</label>
    </div>

    <button type="submit" class="btn btn-primary">Create deck</button>
    <a href="decks" class="btn btn-link">Cancel</a>
</EditForm>

@code {
    // The signed-in user.
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    // Input: filled from the posted form fields (or empty on first display).
    [SupplyParameterFromForm] private NewDeckModel Input { get; set; } = default!;

    // `??=`: create an empty model only if the form post didn't supply one.
    protected override void OnInitialized() => Input ??= new();

    // CreateAsync: runs only when validation passes. Creates the deck and goes to its page.
    private async Task CreateAsync()
    {
        var user = (await AuthState).User;
        var deck = await DeckService.CreateAsync(user.GetUserId()!, Input.Name, Input.Format, Input.IsPublic);
        Navigation.NavigateTo($"decks/{deck.Id}");
    }

    // NewDeckModel: the form's fields and their validation rules.
    private sealed class NewDeckModel
    {
        [Required(ErrorMessage = "Give the deck a name.")]
        [StringLength(Deck.MaxNameLength)]
        public string Name { get; set; } = "";

        [Required]
        [AllowedFormat]
        public string Format { get; set; } = DeckFormats.Default;

        public bool IsPublic { get; set; }
    }

    // AllowedFormatAttribute: a custom validation rule — the value must be a known format
    // (stops a hand-crafted POST with format=anything).
    private sealed class AllowedFormatAttribute : ValidationAttribute
    {
        protected override ValidationResult? IsValid(object? value, ValidationContext context) =>
            value is string format && DeckFormats.IsKnown(format) ? ValidationResult.Success : new ValidationResult("Pick a format from the list.");
    }
}
