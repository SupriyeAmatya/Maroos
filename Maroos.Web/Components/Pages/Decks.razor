@* =====================================================================================================
   FILE: Maroos.Web/Components/Pages/Decks.razor      URL: /decks
   PURPOSE: "My decks" — a table of the signed-in user's decks (name, format, card count, public/private,
   last updated) and a "New deck" button.
   SECURITY: [Authorize] — visitors are sent to the login page. Only the caller's own decks are listed.
   ===================================================================================================== *@
@page "/decks"

@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]

@inject DeckService DeckService

<PageTitle>My decks · Maroos</PageTitle>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h1 class="mb-0">My decks</h1>
    <a class="btn btn-primary" href="decks/new">New deck</a>
</div>

@if (decks is null)
{
    <p class="text-muted">Loading…</p>
}
else if (decks.Count == 0)
{
    @* Empty state: tell new users what to do. *@
    <p>You haven't built a deck yet. <a href="decks/new">Start one</a> and paste in a list or add cards one by one.</p>
}
else
{
    @* table-responsive: the table scrolls sideways on narrow phones instead of breaking the layout. *@
    <div class="table-responsive">
        <table class="table align-middle deck-table">
            <thead>
                <tr>
                    <th scope="col">Name</th>
                    <th scope="col">Format</th>
                    <th scope="col" class="text-end">Cards</th>
                    <th scope="col">Visibility</th>
                    <th scope="col">Updated</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var deck in decks)
                {
                    <tr>
                        <td><a href="decks/@deck.Id">@deck.Name</a></td>
                        <td>@DeckFormats.DisplayName(deck.Format)</td>
                        @* "60 + 15" = main deck + sideboard. *@
                        <td class="text-end">
                            @deck.MainCount
                            @if (deck.SideCount > 0)
                            {
                                <span class="text-muted"> + @deck.SideCount</span>
                            }
                        </td>
                        <td>
                            <span class="badge @(deck.IsPublic ? "text-bg-success" : "text-bg-secondary")">@(deck.IsPublic ? "Public" : "Private")</span>
                        </td>
                        @* <time> with a machine-readable ISO date ("o" format) and a friendly display date. *@
                        <td><time datetime="@deck.UpdatedAt.ToString("o")">@deck.UpdatedAt.ToString("MMM d, yyyy")</time></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    // The signed-in user.
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    // decks: null while loading.
    private IReadOnlyList<DeckSummary>? decks;

    // Load this user's decks. `!` — [Authorize] guarantees a signed-in user, so the id isn't null.
    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        decks = await DeckService.ListAsync(user.GetUserId()!);
    }
}
