@* =====================================================================================================
   FILE: Maroos.Web/Components/Pages/ListCard.razor      URL: /auctions/new
   PURPOSE: The "List a card" form, in three steps:
     1. Card — type a name, press Find, pick the exact printing (every paper printing, newest first).
     2. Condition and photo — NM/LP/MP/HP/DMG, foil, optional photo of your actual copy.
     3. Price and length — starting price, minimum increment, 1/3/5/7 days.
   Then "List card": the photo is cleaned and stored (AuctionPhotoStore), the listing is created
   (AuctionService.CreateAsync validates everything again), and the new auction page opens.
   If anything fails after the photo was stored, the photo is deleted again (no orphan files).
   RENDERING: InteractiveServer (autocomplete, printing picker, file upload).
   SECURITY: [Authorize]; the seller is always the signed-in user.
   ===================================================================================================== *@
@page "/auctions/new"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]

@inject AuctionService AuctionService
@inject AuctionPhotoStore Photos
@inject CardService Cards
@inject NavigationManager Navigation

<PageTitle>List a card · Maroos</PageTitle>

<h1>List a card</h1>
<p class="text-muted">Auctions settle between buyer and seller: when yours ends, the winner contacts you to arrange payment and shipping.</p>

<div class="new-auction">
    <div class="new-auction-form">
        @* ---- Step 1: find the card and choose the printing ---- *@
        <section class="mb-4" aria-labelledby="step-card">
            <h2 id="step-card" class="h5">1. Card</h2>
            <CardAutocomplete ButtonText="Find" ListId="auction-card-suggestions" Disabled="busy"
                              AriaLabel="Card name" Placeholder="Card name, e.g. Sol Ring" OnSubmit="FindPrintingsAsync" />

            @if (printingsError is not null)
            {
                <div class="alert alert-warning py-2 mt-2 mb-0">@printingsError</div>
            }
            else if (printings.Count > 0)
            {
                @* Printing dropdown, e.g. "Commander Masters (CMM) #395". *@
                <label for="auction-printing" class="form-label mt-3">Printing</label>
                <select id="auction-printing" class="form-select" value="@selected?.Id" @onchange="SelectPrinting">
                    @foreach (var printing in printings)
                    {
                        <option value="@printing.Id">@PrintingLabel(printing)</option>
                    }
                </select>
            }
        </section>

        @* ---- Step 2: condition, foil, photo ---- *@
        <section class="mb-4" aria-labelledby="step-details">
            <h2 id="step-details" class="h5">2. Condition and photo</h2>
            <div class="row g-3">
                <div class="col-sm-8">
                    <label for="auction-condition" class="form-label">Condition</label>
                    @* @bind: two-way binding — the select shows `condition`, and changing it updates `condition`. *@
                    <select id="auction-condition" class="form-select" @bind="condition">
                        @foreach (var value in Enum.GetValues<CardCondition>())
                        {
                            <option value="@value">@AuctionRules.ConditionLabel(value) (@AuctionRules.ConditionCode(value))</option>
                        }
                    </select>
                </div>
                <div class="col-sm-4 d-flex align-items-end">
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="auction-foil" @bind="isFoil" />
                        <label class="form-check-label" for="auction-foil">Foil</label>
                    </div>
                </div>
                <div class="col-12">
                    <label for="auction-photo" class="form-label">Photo <span class="text-muted">(optional)</span></label>
                    @* InputFile: Blazor's file picker; the file streams to the server only when we read it in ListAsync. *@
                    <InputFile id="auction-photo" class="form-control" accept="image/jpeg,image/png" OnChange="OnPhotoChosen" disabled="@busy" />
                    <div class="form-text">
                        JPG or PNG, up to 5 MB. A photo of your actual copy helps buyers trust the condition.
                        Location data is removed before it's saved. Without a photo, Scryfall's image is shown.
                    </div>
                    @if (photoError is not null)
                    {
                        <div class="text-danger small mt-1">@photoError</div>
                    }
                </div>
            </div>
        </section>

        @* ---- Step 3: price and duration ---- *@
        <section class="mb-4" aria-labelledby="step-price">
            <h2 id="step-price" class="h5">3. Price and length</h2>
            <div class="row g-3">
                <div class="col-sm-4">
                    <label for="auction-start" class="form-label">Starting price</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input id="auction-start" class="form-control" inputmode="decimal" @bind="startPrice" placeholder="5.00" />
                    </div>
                    @* Hint: Scryfall's market price for this printing (foil price if foil is ticked). *@
                    @if (selected?.DeckPriceCents is { } market)
                    {
                        <div class="form-text">Scryfall price: @Money.FormatUsd(market)</div>
                    }
                </div>
                <div class="col-sm-4">
                    <label for="auction-increment" class="form-label">Minimum bid increment</label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input id="auction-increment" class="form-control" inputmode="decimal" @bind="increment" />
                    </div>
                </div>
                <div class="col-sm-4">
                    <label for="auction-duration" class="form-label">Runs for</label>
                    <select id="auction-duration" class="form-select" @bind="durationDays">
                        @foreach (var days in AuctionRules.DurationChoices)
                        {
                            <option value="@days">@days day@(days == 1 ? "" : "s")</option>
                        }
                    </select>
                </div>
            </div>
        </section>

        @* Errors, announced by screen readers when they appear (aria-live). *@
        <div role="alert" aria-live="polite">
            @if (errors.Count > 0)
            {
                <div class="alert alert-danger">
                    <ul class="mb-0">
                        @foreach (var error in errors)
                        {
                            <li>@error</li>
                        }
                    </ul>
                </div>
            }
        </div>

        <button type="button" class="btn btn-primary btn-lg" disabled="@busy" @onclick="ListAsync">
            @(busy ? "Listing…" : "List card")
        </button>
        <a href="auctions" class="btn btn-link">Cancel</a>
    </div>

    @* Right column: a preview image of the chosen printing. *@
    <aside class="new-auction-preview" aria-label="Selected printing">
        @if (selected?.FrontImage?.Normal is { } image)
        {
            <img src="@image" alt="@selected.Name" />
            <p class="small text-muted mt-2 mb-0">@PrintingLabel(selected)</p>
        }
    </aside>
</div>

@code {
    // The signed-in user (the seller).
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    // Step 1 state: the printings found, the chosen one, and any lookup error.
    private IReadOnlyList<ScryfallCard> printings = [];
    private ScryfallCard? selected;
    private string? printingsError;

    // Step 2 state. `photo` is the chosen file (not read yet).
    private CardCondition condition = CardCondition.NearMint;
    private bool isFoil;
    private IBrowserFile? photo;
    private string? photoError;

    // Step 3 state: prices as the text typed (parsed on submit), default increment $1.00, default 7 days.
    private string startPrice = "";
    private string increment = Money.FormatInput(AuctionRules.DefaultIncrementCents);
    private int durationDays = 7;

    // errors: shown above the button. busy: a request is running (buttons disabled).
    private List<string> errors = [];
    private bool busy;

    /// <summary>Loads every paper printing of the chosen card, newest first.</summary>
    // Scryfall query: exact name, every printing (unique:prints), not digital-only, newest release first.
    private async Task FindPrintingsAsync(CardAutocompleteSubmit submit)
    {
        busy = true;
        printingsError = null;
        try
        {
            var results = await Cards.SearchAsync($"!\"{submit.Text}\" unique:prints -is:digital order:released dir:desc");
            printings = results.Data;
            selected = printings.FirstOrDefault();
            if (selected is null)
                printingsError = $"Scryfall has no paper card named “{submit.Text}”. Pick a name from the suggestions.";
        }
        // Scryfall answers 404 for "no results" (and may be unreachable).
        catch (HttpRequestException)
        {
            printingsError = "Couldn't reach Scryfall. Try again in a moment.";
        }
        finally
        {
            busy = false;
        }
    }

    // SelectPrinting: the dropdown changed — find the printing by id (keep the old one if not found).
    private void SelectPrinting(ChangeEventArgs e) =>
        selected = printings.FirstOrDefault(p => p.Id.ToString() == e.Value?.ToString()) ?? selected;

    // PrintingLabel: "Set name (SET) #number".
    private static string PrintingLabel(ScryfallCard card) =>
        $"{card.SetName} ({card.Set.ToUpperInvariant()}) #{card.CollectorNumber}";

    // OnPhotoChosen: quick checks (type and size) as soon as a file is picked, for fast feedback.
    // The real checks happen in AuctionPhotoStore when the file is saved.
    private void OnPhotoChosen(InputFileChangeEventArgs e)
    {
        photo = null;
        photoError = null;
        var file = e.File;
        if (!AuctionPhotoStore.AcceptedTypes.Contains(file.ContentType))
            photoError = "Upload a JPG or PNG photo.";
        else if (file.Size > AuctionPhotoStore.MaxUploadBytes)
            photoError = "Photos can be up to 5 MB.";
        else
            photo = file;
    }

    // ListAsync: the "List card" button.
    private async Task ListAsync()
    {
        // 1. Check the form (all problems collected, then shown together).
        errors = [];
        if (selected is null)
            errors.Add("Find the card you're selling first.");
        if (!Money.TryParseUsd(startPrice, out var startCents))
            errors.Add("Enter a starting price, like 5.00.");
        if (!Money.TryParseUsd(increment, out var incrementCents))
            errors.Add("Enter a bid increment, like 1.00.");
        if (photoError is not null)
            errors.Add(photoError);
        if (errors.Count > 0)
            return;

        busy = true;
        string? photoPath = null;
        try
        {
            // 2. Photo (optional): stream it (capped at 5 MB) into the photo store.
            if (photo is not null)
            {
                await using var stream = photo.OpenReadStream(AuctionPhotoStore.MaxUploadBytes);
                photoPath = await Photos.SaveAsync(stream);
            }

            // 3. Create the listing and open its page.
            var sellerId = (await AuthState).User.GetUserId()!;
            var auction = await AuctionService.CreateAsync(sellerId,
                new NewAuction(selected!.Id, condition, isFoil, startCents, incrementCents, durationDays, photoPath));
            Navigation.NavigateTo($"auctions/{auction.Id}");
        }
        // Expected failures: remove the stored photo (if any) and show the reason.
        catch (Exception ex) when (ex is AuctionValidationException or PhotoRejectedException or IOException)
        {
            await Photos.DeleteAsync(photoPath);
            errors = ex is AuctionValidationException validation ? [.. validation.Errors]
                   : ex is PhotoRejectedException ? [ex.Message]
                   : ["Couldn't read that photo. Try choosing it again."];
        }
        finally
        {
            busy = false;
        }
    }
}
