@* =================================================================================================
   FILE: Maroos.Web/Components/Account/Shared/StatusMessage.razor
   ORIGIN: generated by the Blazor Identity template; Maroos uses it unchanged.
   PURPOSE: The green (success) or red (error) message at the top of account pages, e.g. "Your profile
   has been updated". Messages starting with "Error" are shown red.
   WHERE THE MESSAGE COMES FROM: either the Message parameter, or the one-off cookie that
   IdentityRedirectManager.RedirectToWithStatus set just before redirecting here.
   ================================================================================================= *@
@if (!string.IsNullOrEmpty(DisplayMessage))
{
    var statusMessageClass = DisplayMessage.StartsWith("Error") ? "danger" : "success";
    <div class="alert alert-@statusMessageClass" role="alert">
        @DisplayMessage
    </div>
}

@code {
    // messageFromCookie: the message carried over a redirect in the status cookie.
    private string? messageFromCookie;

    [Parameter]
    public string? Message { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // DisplayMessage: the parameter wins; otherwise the cookie's message.
    private string? DisplayMessage => Message ?? messageFromCookie;

    // Read the cookie, then delete it so the message shows only once.
    protected override void OnInitialized()
    {
        messageFromCookie = HttpContext.Request.Cookies[IdentityRedirectManager.StatusCookieName];

        if (messageFromCookie is not null)
        {
            HttpContext.Response.Cookies.Delete(IdentityRedirectManager.StatusCookieName);
        }
    }
}
