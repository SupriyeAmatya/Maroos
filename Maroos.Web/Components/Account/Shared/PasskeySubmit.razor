@* =================================================================================================
   FILE: Maroos.Web/Components/Account/Shared/PasskeySubmit.razor
   ORIGIN: generated by the Blazor Identity template; Maroos uses it unchanged.
   PURPOSE: A submit button that creates or uses a passkey (a phone/laptop/security-key login instead of
   a password). The <passkey-submit> element is a custom HTML element defined in PasskeySubmit.razor.js:
   when the button is clicked, the script talks to the browser's passkey API and fills in the form.
   The antiforgery token values are handed to the script so its own requests are accepted.
   ================================================================================================= *@
@using Microsoft.AspNetCore.Antiforgery
@inject IServiceProvider Services

@* @attributes passes any extra attributes (class="btn ...") straight onto the button. *@
<button type="submit" name="__passkeySubmit" @attributes="AdditionalAttributes">@ChildContent</button>
<passkey-submit
    operation="@Operation"
    name="@Name"
    email-name="@EmailName"
    request-token-name="@tokens?.HeaderName"
    request-token-value="@tokens?.RequestToken">
</passkey-submit>

@code {
    // tokens: the antiforgery header name and value for the script's fetch calls.
    private AntiforgeryTokenSet? tokens;

    // HttpContext: the current request (only available on statically rendered pages like the account pages).
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Operation: Create (register a passkey) or Request (sign in with one).
    [Parameter]
    [EditorRequired]
    public PasskeyOperation Operation { get; set; }

    // Name: the form field the passkey result is written into.
    [Parameter]
    [EditorRequired]
    public string Name { get; set; } = default!;

    // EmailName: the form's email field, so sign-in can suggest that user's passkeys.
    [Parameter]
    public string? EmailName { get; set; }

    // ChildContent: the button's text.
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    // AdditionalAttributes: every other attribute written on <PasskeySubmit ...> (CaptureUnmatchedValues).
    [Parameter(CaptureUnmatchedValues = true)]
    public IDictionary<string, object>? AdditionalAttributes { get; set; }

    protected override void OnInitialized()
    {
        tokens = Services.GetService<IAntiforgery>()?.GetTokens(HttpContext);
    }
}
