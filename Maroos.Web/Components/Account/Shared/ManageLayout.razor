@* =================================================================================================
   FILE: Maroos.Web/Components/Account/Shared/ManageLayout.razor
   ORIGIN: generated by the Blazor Identity template; Maroos uses it unchanged.
   PURPOSE: The layout of every /Account/Manage page: a heading, the settings menu on the left
   (ManageNavMenu) and the page itself on the right. It sits inside the site's MainLayout.
   Pages get it automatically from Pages/Manage/_Imports.razor (@layout ManageLayout).
   ================================================================================================= *@
@inherits LayoutComponentBase
@layout Maroos.Web.Components.Layout.MainLayout

<h1>Manage your account</h1>

<div>
    <h2>Change your account settings</h2>
    <hr />
    @* Bootstrap grid: 3 of 12 columns for the menu, 9 for the page (stacked on narrow screens). *@
    <div class="row">
        <div class="col-lg-3">
            <ManageNavMenu />
        </div>
        <div class="col-lg-9">
            @* @Body: where the current Manage page is drawn. *@
            @Body
        </div>
    </div>
</div>
