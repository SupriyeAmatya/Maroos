@* =================================================================================================
   FILE: Maroos.Web/Components/Account/Shared/ExternalLoginPicker.razor
   ORIGIN: generated by the Blazor Identity template; Maroos uses it unchanged.
   PURPOSE: The "Use another service to log in" buttons on the Login and Register pages: one button per
   external login provider (in Maroos, GitHub, and only when its keys are configured).
   Each button posts to /Account/PerformExternalLogin (IdentityComponentsEndpointRouteBuilderExtensions.cs).
   ================================================================================================= *@
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using Maroos.Web.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

@* No providers configured (e.g. no GitHub keys in development): the template's explanation instead of buttons. *@
@if (externalLogins.Length == 0)
{
    <div>
        <p>
            There are no external authentication services configured. See this <a href="https://go.microsoft.com/fwlink/?LinkID=532715">article
            about setting up this ASP.NET application to support logging in via external services</a>.
        </p>
    </div>
}
else
{
    @* A plain HTML form (not a Blazor event): the POST must reach the server endpoint, which redirects to GitHub.
       AntiforgeryToken proves the form came from this site; ReturnUrl brings the user back afterwards. *@
    <form class="form-horizontal" action="Account/PerformExternalLogin" method="post">
        <div>
            <AntiforgeryToken />
            <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
            <p>
                @foreach (var provider in externalLogins)
                {
                    <button type="submit" class="btn btn-primary" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">@provider.DisplayName</button>
                }
            </p>
        </div>
    </form>
}

@code {
    // externalLogins: the configured providers ("schemes").
    private AuthenticationScheme[] externalLogins = [];

    // ReturnUrl: read from the page's query string (?ReturnUrl=...).
    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    // Ask Identity which external providers are registered (Program.cs adds GitHub only when configured).
    protected override async Task OnInitializedAsync()
    {
        externalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).ToArray();
    }
}
