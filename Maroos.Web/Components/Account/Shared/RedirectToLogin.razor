@* =================================================================================================
   FILE: Maroos.Web/Components/Account/Shared/RedirectToLogin.razor
   ORIGIN: generated by the Blazor Identity template; Maroos uses it unchanged.
   PURPOSE: Used by Routes.razor when a page needs a signed-in user ([Authorize]) and the visitor isn't:
   it sends them to the login page with ?returnUrl=<this page>, so they come back after logging in.
   forceLoad: a full page load, because the login page is a normal (static) page.
   ================================================================================================= *@
@inject NavigationManager NavigationManager

@code {
    protected override void OnInitialized()
    {
        NavigationManager.NavigateTo($"Account/Login?returnUrl={Uri.EscapeDataString(NavigationManager.Uri)}", forceLoad: true);
    }
}
