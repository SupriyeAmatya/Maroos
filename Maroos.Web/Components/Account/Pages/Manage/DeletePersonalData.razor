@* =================================================================================================
   FILE: Maroos.Web/Components/Account/Pages/Manage/DeletePersonalData.razor URL: /Account/Manage/DeletePersonalData
   ORIGIN: generated by the Blazor Identity template; Maroos uses it unchanged.
   PURPOSE: Delete your account for good (asks for the password if the account has one).
   IN MAROOS: deleting the user also deletes their decks, listings, bids, watches and queued emails
   (cascade rules in ApplicationDbContext); auctions they had won stay, with no winner.
   Signed-in users only ([Authorize] from Manage/_Imports.razor); shown inside ManageLayout.
   ================================================================================================= *@
@page "/Account/Manage/DeletePersonalData"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Maroos.Web.Data

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<DeletePersonalData> Logger

<PageTitle>Delete Personal Data</PageTitle>

<StatusMessage Message="@message" />

<h3>Delete Personal Data</h3>

<div class="alert alert-warning" role="alert">
    <p>
        <strong>Deleting this data will permanently remove your account, and this cannot be recovered.</strong>
    </p>
</div>

<div>
    @* EditForm posts a normal HTML form (method="post"); FormName tells Blazor which form on the page was
       submitted. OnValidSubmit runs only when every validation rule on InputModel passes. *@
    <EditForm Model="Input" FormName="delete-user" OnValidSubmit="OnValidSubmitAsync" method="post">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" role="alert" />
        @if (requirePassword)
        {
            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.Password" id="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Please enter your password." />
                <label for="Input.Password" class="form-label">Password</label>
                <ValidationMessage For="() => Input.Password" class="text-danger" />
            </div>
        }
        <button class="w-100 btn btn-lg btn-danger" type="submit">Delete data and close my account</button>
    </EditForm>
</div>

@code {
    // message: the result shown by <StatusMessage>.
    private string? message;
    // user: the signed-in account (null if the login cookie's account is gone).
    private ApplicationUser? user;
    // requirePassword: only accounts with a password must type it (GitHub-only ones can't).
    private bool requirePassword;

    // HttpContext: the current request. Account pages are statically rendered, so it's available (it isn't on
    // interactive pages); they use it for cookies, status codes and sign-in.
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Input: the form's fields. [SupplyParameterFromForm] fills it from the posted form.
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    // Step 1 (every Manage page): load the signed-in user; if the cookie's account no longer exists, show InvalidUser.
    protected override async Task OnInitializedAsync()
    {
        // On a first visit (GET) nothing was posted, so Input is null: start with an empty form.
        Input ??= new();

        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }
        requirePassword = await UserManager.HasPasswordAsync(user);
    }

    // Step 1: check the password. Step 2: delete the user (and, through the database, their data).
    // Step 3: sign out, log it, and reload (now signed out, so [Authorize] sends them to the login page).
    private async Task OnValidSubmitAsync()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        if (requirePassword && !await UserManager.CheckPasswordAsync(user, Input.Password))
        {
            message = "Error: Incorrect password.";
            return;
        }

        var result = await UserManager.DeleteAsync(user);
        if (!result.Succeeded)
        {
            throw new InvalidOperationException("Unexpected error occurred deleting user.");
        }

        await SignInManager.SignOutAsync();

        var userId = await UserManager.GetUserIdAsync(user);
        Logger.LogInformation("User with ID '{UserId}' deleted themselves.", userId);

        RedirectManager.RedirectToCurrentPage();
    }

    // InputModel: the form's fields with their validation rules ([Required], [EmailAddress], [StringLength]...).
    // DataAnnotationsValidator on the page checks them before the submit handler runs.
    private sealed class InputModel
    {
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";
    }
}
