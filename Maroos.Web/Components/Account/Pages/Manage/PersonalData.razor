@* =================================================================================================
   FILE: Maroos.Web/Components/Account/Pages/Manage/PersonalData.razor      URL: /Account/Manage/PersonalData
   ORIGIN: generated by the Blazor Identity template; Maroos uses it unchanged.
   PURPOSE: Your data: a Download button (POST /Account/Manage/DownloadPersonalData, which returns a JSON
   file) and a link to delete the account.
   Signed-in users only ([Authorize] from Manage/_Imports.razor); shown inside ManageLayout.
   ================================================================================================= *@
@page "/Account/Manage/PersonalData"

@using Microsoft.AspNetCore.Identity
@using Maroos.Web.Data

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Personal Data</PageTitle>

<StatusMessage />
<h3>Personal Data</h3>

<div class="row">
    <div class="col-md-6">
        <p>Your account contains personal data that you have given us. This page allows you to download or delete that data.</p>
        <p>
            <strong>Deleting this data will permanently remove your account, and this cannot be recovered.</strong>
        </p>
        @* A plain POST form: the endpoint returns a file download, which a Blazor form can't do. *@
        <form action="Account/Manage/DownloadPersonalData" method="post">
            <AntiforgeryToken />
            <button class="btn btn-primary" type="submit">Download</button>
        </form>
        <p>
            <a href="Account/Manage/DeletePersonalData" class="btn btn-danger">Delete</a>
        </p>
    </div>
</div>

@code {
    // HttpContext: the current request. Account pages are statically rendered, so it's available (it isn't on
    // interactive pages); they use it for cookies, status codes and sign-in.
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Only checks that the signed-in account still exists.
    protected override async Task OnInitializedAsync()
    {
        var user  = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
        }
    }
}
