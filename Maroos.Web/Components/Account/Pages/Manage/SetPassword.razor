@* =================================================================================================
   FILE: Maroos.Web/Components/Account/Pages/Manage/SetPassword.razor       URL: /Account/Manage/SetPassword
   ORIGIN: generated by the Blazor Identity template; Maroos uses it unchanged.
   PURPOSE: Add a password to an account that only logs in with GitHub, so it can also log in with
   email + password. Accounts that already have one are sent to ChangePassword.
   Signed-in users only ([Authorize] from Manage/_Imports.razor); shown inside ManageLayout.
   ================================================================================================= *@
@page "/Account/Manage/SetPassword"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Maroos.Web.Data

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Set password</PageTitle>

<h3>Set your password</h3>
<StatusMessage Message="@message" />
<p class="text-info">
    You do not have a local username/password for this site. Add a local
    account so you can log in without an external login.
</p>
<div class="row">
    <div class="col-xl-6">
        @* EditForm posts a normal HTML form (method="post"); FormName tells Blazor which form on the page was
           submitted. OnValidSubmit runs only when every validation rule on InputModel passes. *@
        <EditForm Model="Input" FormName="set-password" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.NewPassword" id="Input.NewPassword" class="form-control" autocomplete="new-password" placeholder="Enter the new password" />
                <label for="Input.NewPassword" class="form-label">New password</label>
                <ValidationMessage For="() => Input.NewPassword" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.ConfirmPassword" id="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="Enter the new password" />
                <label for="Input.ConfirmPassword" class="form-label">Confirm password</label>
                <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger" />
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Set password</button>
        </EditForm>
     </div>
</div>

@code {
    // message: the result shown by <StatusMessage>.
    private string? message;
    // user: the signed-in account (null if the login cookie's account is gone).
    private ApplicationUser? user;

    // HttpContext: the current request. Account pages are statically rendered, so it's available (it isn't on
    // interactive pages); they use it for cookies, status codes and sign-in.
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Input: the form's fields. [SupplyParameterFromForm] fills it from the posted form.
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    // Step 1 (every Manage page): load the signed-in user; if the cookie's account no longer exists, show InvalidUser.
    // Step 2: already has a password? Go to ChangePassword.
    protected override async Task OnInitializedAsync()
    {
        // On a first visit (GET) nothing was posted, so Input is null: start with an empty form.
        Input ??= new();

        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        var hasPassword = await UserManager.HasPasswordAsync(user);
        if (hasPassword)
        {
            RedirectManager.RedirectTo("Account/Manage/ChangePassword");
        }
    }

    // Add the password, refresh the login cookie, report success.
    private async Task OnValidSubmitAsync()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        var addPasswordResult = await UserManager.AddPasswordAsync(user, Input.NewPassword!);
        if (!addPasswordResult.Succeeded)
        {
            message = $"Error: {string.Join(",", addPasswordResult.Errors.Select(error => error.Description))}";
            return;
        }

        await SignInManager.RefreshSignInAsync(user);
        RedirectManager.RedirectToCurrentPageWithStatus("Your password has been set.", HttpContext);
    }

    // InputModel: the form's fields with their validation rules ([Required], [EmailAddress], [StringLength]...).
    // DataAnnotationsValidator on the page checks them before the submit handler runs.
    private sealed class InputModel
    {
        [Required]
        [StringLength(100, ErrorMessage = "The {0} must be at least {2} and at max {1} characters long.", MinimumLength = 6)]
        [DataType(DataType.Password)]
        [Display(Name = "New password")]
        public string? NewPassword { get; set; }

        [DataType(DataType.Password)]
        [Display(Name = "Confirm new password")]
        [Compare("NewPassword", ErrorMessage = "The new password and confirmation password do not match.")]
        public string? ConfirmPassword { get; set; }
    }
}
