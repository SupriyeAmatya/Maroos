@* =================================================================================================
   FILE: Maroos.Web/Components/Account/Pages/LoginWithRecoveryCode.razor    URL: /Account/LoginWithRecoveryCode
   ORIGIN: generated by the Blazor Identity template; Maroos uses it unchanged.
   PURPOSE: Log in with one of your saved recovery codes when the authenticator app isn't available.
   Each code works once.
   ================================================================================================= *@
@page "/Account/LoginWithRecoveryCode"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Maroos.Web.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<LoginWithRecoveryCode> Logger

<PageTitle>Recovery code verification</PageTitle>

<h1>Recovery code verification</h1>
<hr />
<StatusMessage Message="@message" />
<p>
    You have requested to log in with a recovery code. This login will not be remembered until you provide
    an authenticator app code at log in or disable 2FA and log in again.
</p>
<div class="row">
    <div class="col-md-4">
        @* EditForm posts a normal HTML form (method="post"); FormName tells Blazor which form on the page was
           submitted. OnValidSubmit runs only when every validation rule on InputModel passes. *@
        <EditForm Model="Input" FormName="login-with-recovery-code" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.RecoveryCode" id="Input.RecoveryCode" class="form-control" autocomplete="off" placeholder="RecoveryCode" />
                <label for="Input.RecoveryCode" class="form-label">Recovery Code</label>
                <ValidationMessage For="() => Input.RecoveryCode" class="text-danger" />
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Log in</button>
        </EditForm>
    </div>
</div>

@code {
    // message: the result shown by <StatusMessage>.
    private string? message;
    // user: the signed-in account, loaded in OnInitializedAsync.
    private ApplicationUser user = default!;

    // Input: the form's fields. [SupplyParameterFromForm] fills it from the posted form.
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    // ReturnUrl: where to go after success (from ?ReturnUrl=...).
    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    // As on LoginWith2fa: only reachable after the password step.
    protected override async Task OnInitializedAsync()
    {
        // On a first visit (GET) nothing was posted, so Input is null: start with an empty form.
        Input ??= new();

        // Ensure the user has gone through the username & password screen first
        user = await SignInManager.GetTwoFactorAuthenticationUserAsync() ??
            throw new InvalidOperationException("Unable to load two-factor authentication user.");
    }

    // Check the code (spaces removed) and sign in; a used code is removed from the account.
    // Success -> ReturnUrl; locked out -> Lockout page; wrong code -> error message.
    private async Task OnValidSubmitAsync()
    {
        var recoveryCode = Input.RecoveryCode.Replace(" ", string.Empty);

        var result = await SignInManager.TwoFactorRecoveryCodeSignInAsync(recoveryCode);

        var userId = await UserManager.GetUserIdAsync(user);

        if (result.Succeeded)
        {
            Logger.LogInformation("User with ID '{UserId}' logged in with a recovery code.", userId);
            RedirectManager.RedirectTo(ReturnUrl);
        }
        else if (result.IsLockedOut)
        {
            Logger.LogWarning("User account locked out.");
            RedirectManager.RedirectTo("Account/Lockout");
        }
        else
        {
            Logger.LogWarning("Invalid recovery code entered for user with ID '{UserId}' ", userId);
            message = "Error: Invalid recovery code entered.";
        }
    }

    // InputModel: the form's fields with their validation rules ([Required], [EmailAddress], [StringLength]...).
    // DataAnnotationsValidator on the page checks them before the submit handler runs.
    private sealed class InputModel
    {
        [Required]
        [DataType(DataType.Text)]
        [Display(Name = "Recovery Code")]
        public string RecoveryCode { get; set; } = "";
    }
}
