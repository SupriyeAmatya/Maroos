@* =================================================================================================
   FILE: Maroos.Web/Components/Account/Pages/LoginWith2fa.razor             URL: /Account/LoginWith2fa
   ORIGIN: generated by the Blazor Identity template; Maroos uses it unchanged.
   PURPOSE: Second step of logging in for accounts with two-factor authentication: after the right
   password, enter the 6-digit code from your authenticator app. "Remember this machine" skips this step
   on this browser next time. No phone? The page links to LoginWithRecoveryCode.
   ================================================================================================= *@
@page "/Account/LoginWith2fa"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using Maroos.Web.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<LoginWith2fa> Logger

<PageTitle>Two-factor authentication</PageTitle>

<h1>Two-factor authentication</h1>
<hr />
<StatusMessage Message="@message" />
<p>Your login is protected with an authenticator app. Enter your authenticator code below.</p>
<div class="row">
    <div class="col-md-4">
        @* EditForm posts a normal HTML form (method="post"); FormName tells Blazor which form on the page was
           submitted. OnValidSubmit runs only when every validation rule on InputModel passes. *@
        <EditForm Model="Input" FormName="login-with-2fa" OnValidSubmit="OnValidSubmitAsync" method="post">
            <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
            <input type="hidden" name="RememberMe" value="@RememberMe" />
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.TwoFactorCode" id="Input.TwoFactorCode" class="form-control" autocomplete="off" />
                <label for="Input.TwoFactorCode" class="form-label">Authenticator code</label>
                <ValidationMessage For="() => Input.TwoFactorCode" class="text-danger" />
            </div>
            <div class="checkbox mb-3">
                <label for="remember-machine" class="form-label">
                    <InputCheckbox @bind-Value="Input.RememberMachine" />
                    Remember this machine
                </label>
            </div>
            <div>
                <button type="submit" class="w-100 btn btn-lg btn-primary">Log in</button>
            </div>
        </EditForm>
    </div>
</div>
<p>
    Don't have access to your authenticator device? You can
    <a href="Account/LoginWithRecoveryCode?ReturnUrl=@ReturnUrl">log in with a recovery code</a>.
</p>

@code {
    // message: the result shown by <StatusMessage>.
    private string? message;
    // user: the signed-in account, loaded in OnInitializedAsync.
    private ApplicationUser user = default!;

    // Input: the form's fields. [SupplyParameterFromForm] fills it from the posted form.
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    // ReturnUrl: where to go after success (from ?ReturnUrl=...).
    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    // RememberMe: carried over from the login form (keep me signed in).
    [SupplyParameterFromQuery]
    private bool RememberMe { get; set; }

    // The password step leaves a temporary "two-factor" cookie. Without it, someone skipped the password: error.
    protected override async Task OnInitializedAsync()
    {
        // On a first visit (GET) nothing was posted, so Input is null: start with an empty form.
        Input ??= new();

        // Ensure the user has gone through the username & password screen first
        user = await SignInManager.GetTwoFactorAuthenticationUserAsync() ??
            throw new InvalidOperationException("Unable to load two-factor authentication user.");
    }

    // Step 1: strip spaces and dashes (apps show "123 456"). Step 2: check the code and sign in.
    // Step 3: success -> ReturnUrl; too many failures -> Lockout page; wrong code -> error message.
    // Each outcome is logged with the user's id (never the code).
    private async Task OnValidSubmitAsync()
    {
        var authenticatorCode = Input.TwoFactorCode!.Replace(" ", string.Empty).Replace("-", string.Empty);
        var result = await SignInManager.TwoFactorAuthenticatorSignInAsync(authenticatorCode, RememberMe, Input.RememberMachine);
        var userId = await UserManager.GetUserIdAsync(user);

        if (result.Succeeded)
        {
            Logger.LogInformation("User with ID '{UserId}' logged in with 2fa.", userId);
            RedirectManager.RedirectTo(ReturnUrl);
        }
        else if (result.IsLockedOut)
        {
            Logger.LogWarning("User with ID '{UserId}' account locked out.", userId);
            RedirectManager.RedirectTo("Account/Lockout");
        }
        else
        {
            Logger.LogWarning("Invalid authenticator code entered for user with ID '{UserId}'.", userId);
            message = "Error: Invalid authenticator code.";
        }
    }

    // InputModel: the form's fields with their validation rules ([Required], [EmailAddress], [StringLength]...).
    // DataAnnotationsValidator on the page checks them before the submit handler runs.
    private sealed class InputModel
    {
        [Required]
        [StringLength(7, ErrorMessage = "The {0} must be at least {2} and at max {1} characters long.", MinimumLength = 6)]
        [DataType(DataType.Text)]
        [Display(Name = "Authenticator code")]
        public string? TwoFactorCode { get; set; }

        [Display(Name = "Remember this machine")]
        public bool RememberMachine { get; set; }
    }
}
