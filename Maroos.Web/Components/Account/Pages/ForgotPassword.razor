@* =================================================================================================
   FILE: Maroos.Web/Components/Account/Pages/ForgotPassword.razor           URL: /Account/ForgotPassword
   ORIGIN: generated by the Blazor Identity template; Maroos uses it unchanged.
   PURPOSE: "Forgot your password?": enter your email and get a reset link.
   EMAIL: EmailSender is Maroos's IdentityEmailSender, which queues the email in the outbox
   (Services/Email); the background EmailDispatcher sends it a few seconds later.
   ================================================================================================= *@
@page "/Account/ForgotPassword"

@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using Maroos.Web.Data

@inject UserManager<ApplicationUser> UserManager
@inject IEmailSender<ApplicationUser> EmailSender
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Forgot your password?</PageTitle>

<h1>Forgot your password?</h1>
<h2>Enter your email.</h2>
<hr />
<div class="row">
    <div class="col-md-4">
        @* EditForm posts a normal HTML form (method="post"); FormName tells Blazor which form on the page was
           submitted. OnValidSubmit runs only when every validation rule on InputModel passes. *@
        <EditForm Model="Input" FormName="forgot-password" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />

            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.Email" id="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <label for="Input.Email" class="form-label">Email</label>
                <ValidationMessage For="() => Input.Email" class="text-danger" />
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Reset password</button>
        </EditForm>
     </div>
</div>

@code {
    // Input: the form's fields. [SupplyParameterFromForm] fills it from the posted form.
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override void OnInitialized()
    {
        // On a first visit (GET) nothing was posted, so Input is null: start with an empty form.
        Input ??= new();
    }

    // Step 1: unknown or unconfirmed email: pretend it worked (never reveal who has an account).
    // Step 2: create a one-time reset token, make it URL-safe (Base64Url) and build the /Account/ResetPassword link.
    // Step 3: queue the email, then show the "check your email" page.
    private async Task OnValidSubmitAsync()
    {
        var user = await UserManager.FindByEmailAsync(Input.Email);
        if (user is null || !(await UserManager.IsEmailConfirmedAsync(user)))
        {
            // Don't reveal that the user does not exist or is not confirmed
            RedirectManager.RedirectTo("Account/ForgotPasswordConfirmation");
            return;
        }

        // For more information on how to enable account confirmation and password reset please
        // visit https://go.microsoft.com/fwlink/?LinkID=532713
        var code = await UserManager.GeneratePasswordResetTokenAsync(user);
        code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));
        var callbackUrl = NavigationManager.GetUriWithQueryParameters(
            NavigationManager.ToAbsoluteUri("Account/ResetPassword").AbsoluteUri,
            new Dictionary<string, object?> { ["code"] = code });

        await EmailSender.SendPasswordResetLinkAsync(user, Input.Email, HtmlEncoder.Default.Encode(callbackUrl));

        RedirectManager.RedirectTo("Account/ForgotPasswordConfirmation");
    }

    // InputModel: the form's fields with their validation rules ([Required], [EmailAddress], [StringLength]...).
    // DataAnnotationsValidator on the page checks them before the submit handler runs.
    private sealed class InputModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = "";
    }
}
