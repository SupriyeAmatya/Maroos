@* =================================================================================================
   FILE: Maroos.Web/Components/Account/Pages/ConfirmEmailChange.razor       URL: /Account/ConfirmEmailChange?userId=...&email=...&code=...
   ORIGIN: generated by the Blazor Identity template; Maroos uses it unchanged.
   PURPOSE: The link in the "Confirm your new email" email (sent from Manage > Email) opens this page.
   Only after this does the account's email actually change, so nobody can switch an account to an
   address they don't control.
   ================================================================================================= *@
@page "/Account/ConfirmEmailChange"

@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using Maroos.Web.Data

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Confirm email change</PageTitle>

<h1>Confirm email change</h1>

<StatusMessage Message="@message" />

@code {
    // message: the result shown by <StatusMessage>.
    private string? message;

    // HttpContext: the current request. Account pages are statically rendered, so it's available (it isn't on
    // interactive pages); they use it for cookies, status codes and sign-in.
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // UserId, Email (the new address) and Code: from the link's query string.
    [SupplyParameterFromQuery]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery]
    private string? Email { get; set; }

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    // Step 1: incomplete link: back to login with an error. Step 2: find the user. Step 3: change the email
    // (Identity checks the code). Step 4: the user name is the email here, so change it too. Step 5: refresh the
    // login cookie so it carries the new email.
    protected override async Task OnInitializedAsync()
    {
        if (UserId is null || Email is null || Code is null)
        {
            RedirectManager.RedirectToWithStatus(
                "Account/Login", "Error: Invalid email change confirmation link.", HttpContext);
            return;
        }

        var user = await UserManager.FindByIdAsync(UserId);
        if (user is null)
        {
            message = "Unable to find user with Id '{userId}'";
            return;
        }

        var code = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
        var result = await UserManager.ChangeEmailAsync(user, Email, code);
        if (!result.Succeeded)
        {
            message = "Error changing email.";
            return;
        }

        // In our UI email and user name are one and the same, so when we update the email
        // we need to update the user name.
        var setUserNameResult = await UserManager.SetUserNameAsync(user, Email);
        if (!setUserNameResult.Succeeded)
        {
            message = "Error changing user name.";
            return;
        }

        await SignInManager.RefreshSignInAsync(user);
        message = "Thank you for confirming your email change.";
    }
}
