@* =================================================================================================
   FILE: Maroos.Web/Components/Layout/ReconnectModal.razor
   ORIGIN: generated by the Blazor Web App template; Maroos uses it unchanged.
   PURPOSE: The box shown when an interactive page loses its live (SignalR) connection to the server, for
   example on a flaky network or while the server restarts. Blazor adds CSS classes to the <dialog> as the
   connection state changes; ReconnectModal.razor.css shows the matching message, and ReconnectModal.razor.js
   opens and closes the dialog and runs Retry / Resume. App.razor renders it on every page.
   ================================================================================================= *@
<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

@* The id is fixed: Blazor looks for exactly this element. data-nosnippet keeps its text out of search results. *@
<dialog id="components-reconnect-modal" data-nosnippet>
    <div class="components-reconnect-container">
        @* Two pulsing circles while reconnecting (decorative). *@
        <div class="components-rejoining-animation" aria-hidden="true">
            <div></div>
            <div></div>
        </div>
        @* One message per state; CSS shows only the one matching the dialog's current class. *@
        <p class="components-reconnect-first-attempt-visible">
            Rejoining the server...
        </p>
        <p class="components-reconnect-repeated-attempt-visible">
            Rejoin failed... trying again in <span id="components-seconds-to-next-attempt"></span> seconds.
        </p>
        <p class="components-reconnect-failed-visible">
            Failed to rejoin.<br />Please retry or reload the page.
        </p>
        @* Retry: after reconnecting has failed. *@
        <button id="components-reconnect-button" class="components-reconnect-failed-visible">
            Retry
        </button>
        <p class="components-pause-visible">
            The session has been paused by the server.
        </p>
        <p class="components-resume-failed-visible">
            Failed to resume the session.<br />Please retry or reload the page.
        </p>
        @* Resume: when the server paused the session (e.g. to save memory) or resuming failed. *@
        <button id="components-resume-button" class="components-pause-visible components-resume-failed-visible">
            Resume
        </button>
    </div>
</dialog>
