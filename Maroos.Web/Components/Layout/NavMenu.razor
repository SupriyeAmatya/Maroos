@* Top navigation bar. Icons only until you point at (or tab to) one, which shows its label below it; the pin
   (wwwroot/nav.js) keeps every label visible and remembers the choice in this browser. Labels are always in the
   page, so screen readers read them either way. *@

@implements IDisposable

@inject NavigationManager NavigationManager

<header class="site-nav">
    <nav class="site-nav-inner" aria-label="Main">
        <a class="site-brand" href="">Maroos</a>

        <ul class="nav-items">
            <li>
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="nav-icon icon-home" aria-hidden="true"></span><span class="nav-label">Home</span>
                </NavLink>
            </li>
            <li>
                <NavLink class="nav-link" href="search">
                    <span class="nav-icon icon-search" aria-hidden="true"></span><span class="nav-label">Search</span>
                </NavLink>
            </li>
            <li>
                <NavLink class="nav-link" href="decks">
                    <span class="nav-icon icon-decks" aria-hidden="true"></span><span class="nav-label">Decks</span>
                </NavLink>
            </li>
            <li>
                <NavLink class="nav-link" href="auctions">
                    <span class="nav-icon icon-auctions" aria-hidden="true"></span><span class="nav-label">Auctions</span>
                </NavLink>
            </li>
            <li>
                <NavLink class="nav-link" href="profile">
                    <span class="nav-icon icon-profile" aria-hidden="true"></span><span class="nav-label">Profile</span>
                </NavLink>
            </li>
        </ul>

        <ul class="nav-items nav-items-end">
            <AuthorizeView>
                <Authorized>
                    <li>
                        <NavLink class="nav-link" href="Account/Manage" title="@context.User.Identity?.Name">
                            <span class="nav-icon icon-account" aria-hidden="true"></span><span class="nav-label">Account</span>
                        </NavLink>
                    </li>
                    <li>
                        <form action="Account/Logout" method="post">
                            <AntiforgeryToken />
                            <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                            <button type="submit" class="nav-link">
                                <span class="nav-icon icon-logout" aria-hidden="true"></span><span class="nav-label">Log out</span>
                            </button>
                        </form>
                    </li>
                </Authorized>
                <NotAuthorized>
                    <li>
                        <NavLink class="nav-link" href="Account/Register">
                            <span class="nav-icon icon-register" aria-hidden="true"></span><span class="nav-label">Register</span>
                        </NavLink>
                    </li>
                    <li>
                        <NavLink class="nav-link" href="Account/Login">
                            <span class="nav-icon icon-login" aria-hidden="true"></span><span class="nav-label">Log in</span>
                        </NavLink>
                    </li>
                </NotAuthorized>
            </AuthorizeView>
            <li>
                <button type="button" class="nav-link nav-pin" data-nav-pin aria-pressed="false">
                    <span class="nav-icon icon-pin" aria-hidden="true"></span><span class="nav-label">Always show labels</span>
                </button>
            </li>
        </ul>
    </nav>
</header>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
