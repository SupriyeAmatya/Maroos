<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Maroos.Web: the website (Blazor pages, services, database, background jobs). Sdk.Web adds ASP.NET Core. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- UserSecretsId: where "dotnet user-secrets" keeps development secrets (e.g. GitHub keys), outside the repo.
     BlazorDisableThrowNavigationException: NavigateTo during static rendering redirects without throwing. -->
    <UserSecretsId>aspnet-Maroos_Web-8697c051-79d2-41c3-a505-b5fdf708669d</UserSecretsId>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <!-- The development SQLite file, copied next to the build output when it exists. -->
    <None Update="Data\app.db" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- NuGet packages:
     GitHub                     "Log in with GitHub"
     AWSSDK.S3                  auction photos in any S3-compatible bucket (production)
     MailKit                    sending email over SMTP
     DataProtection.EFCore      cookie-encryption keys stored in the database
     Diagnostics.EFCore         friendly database error pages in development
     Identity.EFCore            user accounts stored with Entity Framework Core
     EFCore.Sqlite              the development database
     EFCore.Design / Tools      "dotnet ef migrations add" and friends (design time only)
     HealthChecks.EFCore        the database check behind /health
     Npgsql...PostgreSQL        the production database
     SkiaSharp (+ Linux assets) decoding and re-encoding uploaded photos (the Linux assets for Docker) -->
    <PackageReference Include="AspNet.Security.OAuth.GitHub" Version="10.0.0" />
    <PackageReference Include="AWSSDK.S3" Version="4.0.103.3" />
    <PackageReference Include="MailKit" Version="4.18.0" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="SkiaSharp" Version="4.152.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.152.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The website uses the rules and models from Maroos.Core. -->
    <ProjectReference Include="..\Maroos.Core\Maroos.Core.csproj" />
  </ItemGroup>

</Project>
